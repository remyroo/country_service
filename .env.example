# Copy to .env for local development and replace the password placeholders.
# Single quotes keep values literal for both Docker Compose and shell sourcing.
DB_USERNAME='country_user'
DB_PASSWORD='replace-with-local-database-password'
MYSQL_ROOT_PASSWORD='replace-with-local-root-password'
# Optional override when the application connects somewhere other than localhost:
# DB_URL='jdbc:mysql://localhost:3306/country_db'
